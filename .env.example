# Reference list of env vars. Real values live only in the Dokploy Environment tab (the app does not run on the laptop).
DATABASE_URL=postgres://mkt:mkt@127.0.0.1:5432/mkt
REDIS_URL=redis://:mkt@127.0.0.1:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGINS=
ANTHROPIC_API_KEY=
STORAGE_DRIVER=fs
FS_ROOT=./data
PROVIDER_MODE=live
REMOTION_CONCURRENCY=2
WORKER_ROLES=all
SELF_IPS=
SMOKESCREEN_URL=http://smokescreen:4750
GITHUB_TOKEN=
MISSED_SLOT_GRACE_MIN=120
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# ── M2 ──
# Vault key-encryption key: 32 random bytes, base64 (openssl rand -base64 32). Keep old versions when rotating.
MKT_KEK_V1_B64=
MKT_KEK_ACTIVE=1
# At least 32 characters (openssl rand -base64 48).
CONFIRM_TOKEN_SECRET=
# STORAGE_DRIVER=r2 needs all four.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mkt-private
# Optional: Healthchecks.io ping URL for the worker heartbeat.
HEALTHCHECK_PING_URL=
# SyllaCal's /api/marketing/aggregate bearer token.
FIRSTPARTY_ANALYTICS_TOKEN=
# Only for scripts/restore-drill.ts: an existing scratch database, never the live one.
RESTORE_DATABASE_URL=
# ── M3a ──
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
