{
  "name": "marketing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @mkt/web build",
    "prepare": "node -e \"try{const x=require('child_process').execSync;x('git rev-parse --git-dir',{stdio:'ignore'});x('git config core.hooksPath .githooks')}catch{}\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "~10.10.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "^4.1.11"
  }
}
